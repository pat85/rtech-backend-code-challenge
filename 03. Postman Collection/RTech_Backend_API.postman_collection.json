                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const firstPage = JSON.parse(pm.collectionVariables.get(\"crewPage1Ids\") || \"[]\");",
                  "const secondPage = body.items.map(x => x.crewMemberId);",
                  "pm.test(\"Page 2 contains at most 5 rows\", () => pm.expect(secondPage.length).to.be.at.most(5));",
                  "pm.test(\"Page 1 and page 2 do not overlap\", () =>",
