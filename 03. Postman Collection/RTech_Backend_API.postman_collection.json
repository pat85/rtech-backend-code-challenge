    {
      "name": "04 - Financial Reports",
      "description": "Runs detailed and summary reports for both Jan-Dec (SHIP01) and Apr-Mar (SHIP02) fiscal years.",
      "item": [
        {
          "name": "Financial detail - SHIP01 - Jan 2025",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ships/{{activeShipCode}}/financial-reports/detail?period={{reportPeriod}}",
              "query": [
                {
                  "key": "period",
                  "value": "{{reportPeriod}}",
                  "disabled": false
                }
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ships",
                "{{activeShipCode}}",
                "financial-reports",
                "detail"
              ]
            },
            "description": "SHIP01 uses Jan-Dec. Posting account 7135000 has Jan 2025 actual 1,000 and budget 1,000."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test(\"Response is an array\", () => pm.expect(rows).to.be.an(\"array\"));",
                  "const account = rows.find(x => x.accountNumber === \"7135000\");",
                  "pm.test(\"Account 7135000 is included\", () => pm.expect(account).to.exist);",
                  "if (account) {",
                  "    pm.test(\"7135000 monthly actual is 1000\", () => pm.expect(Number(account.actualValue)).to.eql(1000));",
                  "    pm.test(\"7135000 monthly budget is 1000\", () => pm.expect(Number(account.budgetValue)).to.eql(1000));",
                  "    pm.test(\"7135000 monthly variance is 0\", () => pm.expect(Number(account.variance)).to.eql(0));",
                  "    pm.test(\"YTD values are populated\", () => {",
                  "        pm.expect(account.actualYTD).to.not.equal(undefined);",
                  "        pm.expect(account.budgetYTD).to.not.equal(undefined);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
