              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{createdUserId}}",
                "ships"
              ]
            },
            "description": "Stored procedure is designed to be idempotent; repeating an assignment should not create a duplicate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipId\": \"{{createdShipId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
