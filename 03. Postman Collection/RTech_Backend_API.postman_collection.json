            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ships/{{activeShipCode}}/crew?pageNumber=1&pageSize=20&sortColumn=RankName&sortDirection=ASC",
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "pageSize",
                  "value": "20",
                  "disabled": false
                },
                {
                  "key": "sortColumn",
                  "value": "RankName",
                  "disabled": false
                },
                {
                  "key": "sortDirection",
                  "value": "ASC",
                  "disabled": false
                }
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ships",
                "{{activeShipCode}}",
                "crew"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Response contains paged fields\", () => {",
                  "    pm.expect(body).to.have.property(\"items\").that.is.an(\"array\");",
                  "    pm.expect(body).to.have.property(\"pageNumber\");",
                  "    pm.expect(body).to.have.property(\"pageSize\");",
                  "    pm.expect(body).to.have.property(\"totalCount\");",
                  "});",
                  "pm.test(\"Crew records have required display fields\", () => {",
                  "    if (body.items.length) {",
                  "        pm.expect(body.items[0]).to.have.property(\"crewMemberId\");",
                  "        pm.expect(body.items[0]).to.have.property(\"rankName\");",
