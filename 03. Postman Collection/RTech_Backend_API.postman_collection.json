    {
      "name": "01 - Users and Ships",
      "description": "Creates a unique Postman user and ship, then stores their IDs for subsequent requests. Run in order.",
      "item": [
        {
          "name": "Create Postman test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Creates a uniquely named user for this collection run. The response saves userId to {{createdUserId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{createdUsername}}\",\n  \"fullName\": \"Postman Test User\",\n  \"email\": \"postman.{{runSuffix}}@example.test\",\n  \"role\": \"Manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set(\"runSuffix\", suffix);",
                  "pm.collectionVariables.set(\"createdUsername\", \"pm.user.\" + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const id = body.userId ?? body.UserId;",
                  "pm.test(\"Response contains userId\", () => pm.expect(id).to.exist);",
                  "pm.collectionVariables.set(\"createdUserId\", String(id));",
                  "pm.test(\"Response contains the generated username\", () =>",
                  "    pm.expect(body.username ?? body.Username).to.eql(pm.collectionVariables.get(\"createdUsername\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get users (verify created user)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?includeInactive=false",
              "query": [
                {
                  "key": "includeInactive",
                  "value": "false",
                  "disabled": false
                }
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "const id = Number(pm.collectionVariables.get(\"createdUserId\"));",
                  "pm.test(\"New user appears in list\", () =>",
                  "    pm.expect(rows.some(x => x.userId === id)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Postman test ship",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ships",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ships"
              ]
            },
            "description": "Creates a unique test ship using an April-March fiscal year. Saves shipId and shipCode.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipCode\": \"{{createdShipCode}}\",\n  \"shipName\": \"Postman Test Vessel\",\n  \"fiscalYearStartMonth\": 4,\n  \"fiscalYearEndMonth\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.collectionVariables.get(\"runSuffix\") || Date.now().toString();",
                  "pm.collectionVariables.set(\"runSuffix\", suffix);",
                  "pm.collectionVariables.set(\"createdShipCode\", \"PM\" + suffix.slice(-10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const id = body.shipId ?? body.ShipId;",
                  "pm.test(\"Response contains shipId\", () => pm.expect(id).to.exist);",
                  "pm.collectionVariables.set(\"createdShipId\", String(id));",
                  "pm.test(\"Fiscal year is April-March\", () => {",
                  "    pm.expect(body.fiscalYearStartMonth ?? body.FiscalYearStartMonth).to.eql(4);",
                  "    pm.expect(body.fiscalYearEndMonth ?? body.FiscalYearEndMonth).to.eql(3);",
                  "});"
                ]
              }
            }
          ]
        },
